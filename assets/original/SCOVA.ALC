DECLARE FUNCTION borra$ (Y1!, y2!)
'$INCLUDE: 'QB.BI'
DIM SHARED INARY%(7), OUTARY%(7)  'Define input and output
											 'arrays for INT86.
'
' Define register-array indices to
' make program easier to understand.
CONST AX = 0, BX = 1, CX = 2, DX = 3, bp = 4, si = 5, di = 6, FL = 7

' |||| S.C.O.V.A. (System for Creation of Old Videoadventures by Alcachofa) ||||
DIM SHARED PPOS(10), PDN(10), NPAN(10), X1(10), Y1(10), x2(10), y2(10)
DIM SHARED PUER(10), NOP(0), NOD(0), NUM(10), NUOD(5), PX(5), PY(5)
DIM SHARED MU$(0), OBJE(450), MASC(450), CACHO(16000), POY(10), POX(10), NUMOB(0), TAMANIOX(0), TAMANIOY(0), NUP(15), NUOBJD(15)


' -- DECLARACION DE FUNCIONES.

	DECLARE FUNCTION COLOCA! (N!)                ' COLOCA EL OBJETO DE DISCO
																' EN LA POSICION DESEADA.

	DECLARE FUNCTION COORDENADAS! (N!)           ' TOMA LAS COORDENADAS DE UN
																' OBJETO EN PANTALLA.

	DECLARE FUNCTION OBJSDISC (P$)               ' INTRODUCE LOS DATOS DE UN
																' OBJETO DE DISCO.

	DECLARE FUNCTION OBJSPANT (P$)               ' INTRODUCE LOS DATOS DE UN
																' OBJETO EN PANTALLA.

	DECLARE FUNCTION GRABAR (P$)                 ' GRABA TODOS LOS DATOS DE
																' LA PANTALLA.

	DECLARE FUNCTION MENS$ (M$, Y, MODO)         ' IMPRIME UN MENSAJE CENTRADO.

	DECLARE FUNCTION CAPANT (P$)                 ' CARGA EN MEMORIA LA PANTALLA
																' ESPECIFICADA.

	DECLARE FUNCTION CORDENA (N)                 ' ELIGE EL OBJETO DE DISCO

	DECLARE FUNCTION RATON ()                    ' LLAMA A LA FUNCION DEL RATON

	TAMANIOX(0) = 39
	TAMANIOY(0) = 24


'ON ERROR GOTO ERRORES                           ' ACTIVA LA INTERCEPCION DE
																' ERRORES.
INARY%(AX) = 0
a = RATON
IF OUTARY%(AX) = 0 THEN PRINT "No tienes instalado el rat\xa2n, hombre.": END

SCREEN 9
' PRESENTACION

	M$ = "ALCACHOFA SOFT S.L. (TM) PRESENTA"
		PRINT MENS$(M$, 1, 2)
	M$ = "|| S.C.O.V.A. (System for Creation of Old Videoadventures by Alcachofa) ||"
		PRINT MENS$(M$, 3, 2)
	M$ = "UN PROGRAMA REALIZADO INTEGRAMENTE EN EL ORDENADOR"
		PRINT MENS$(M$, 5, 2)

	LOCATE 9, 1
		LINE INPUT "ESCRIBE TU NOMBRE:", NOMBRE$
		PRINT "BUENA MEMORIA, "; NOMBRE$; ".", "\xa8NO SERAS DE PENDULO ESTUDIOS?. ES QUE TE HE VISTO ANTES."

' --- PROGRAMA PRINCIPAL

NOO:
NU:
	LOCATE 13, 1: PRINT SPACE$(79 * 2): LOCATE 13, 1
	IF P$ = "" THEN P$ = "1"
	PRINT "NUMERO DE PANTALLA ( "; P$; " ):";
	INPUT "", OP$
	IF OP$ = "" THEN OP$ = P$
	P$ = UCASE$(OP$): P = VAL(P$)              ' P$ ALMACENA EL NUMERO DE LA
															 ' PANTALLA ACTUAL.

	LINE INPUT "MUSICA DE PANTALLA:", OP$
		MU$(0) = UCASE$(OP$)                     ' MU$(P) ALMACENA EL FICHERO DE
															  ' MUSICA DE LA PANTALLA.

	a = CAPANT(P$)                              ' LLAMA A LA FUNCION DE CARGAR
															  ' LA PANTALLA.

	LOCATE 21, 1
		INPUT "NUMERO DE OBJETOS EN PANTALLA:", NOP(0)
		INPUT "NUMERO DE OBJETOS EN DISCO:", NOD(0)

	IF NOP(0) = 0 THEN A1 = 1: GOTO OBD

OBP:
	a = OBJSPANT(P$)                            ' LLAMA A LA FUNCION DE DEFINIR
															  ' OBJETOS EN PANTALLA.


OBD:
	IF NOD(0) = 0 THEN
	IF A1 = 1 THEN
	A1 = 0: GOTO a
	ELSE GOTO GRAB
	END IF
	END IF
	B = OBJSDISC(P$)                            ' LLAMA A LA FUNCION DE DEFINIR
															  ' OBJETOS DE DISCO.
GRAB:
	C = GRABAR(P$)                              ' LLAMA A LA FUNCION DE GRABAR
															  ' LOS DATOS.
a:
SCREEN 9: CLS : P = P + 1:                     '
	P$ = MID$(STR$(P), 2, 1)                    ' SUMA 1 AL NUMERO DE PANTALLA
	GOTO NU                                     ' Y VUELVE A EMPEZAR.


ERRORES:
SCREEN 9: SCREEN 0: END

FUNCTION borra$ (Y1, y2)
VIEW PRINT Y1 TO y2
CLS 2
VIEW PRINT
END FUNCTION

FUNCTION CAPANT (P$)
SCREEN 13
SHELL "CACAGRAF " + P$ + ".ALG"
LINE (0, 155)-(319, 199), 0, BF
END FUNCTION

FUNCTION COLOCA (N)
PRINC:
INARY%(AX) = 0
a = RATON
INARY%(AX) = 7
INARY%(CX) = 1
INARY%(DX) = 280 * 2
a = RATON
INARY%(AX) = 8
INARY%(CX) = 39
INARY%(DX) = 120
a = RATON
DO
INARY%(AX) = 3
a = RATON
IF O = 0 THEN O = OUTARY%(CX) / 2: E = OUTARY%(DX): GET (O, E)-(O + 39, E + 24), CACHO
LOCATE 21, 1: PRINT "X="; OUTARY%(CX) / 2; "               Y="; OUTARY%(DX)
IF OUTARY%(CX) / 2 <> O OR OUTARY%(DX) <> E THEN
PUT (O, E), CACHO, PSET
GET (OUTARY%(CX) / 2, OUTARY%(DX))-((OUTARY%(CX) / 2) + 39, OUTARY%(DX) + 24), CACHO
O = OUTARY%(CX) / 2: E = OUTARY%(DX)
PUT (OUTARY%(CX) / 2, OUTARY%(DX)), MASC, AND
PUT (OUTARY%(CX) / 2, OUTARY%(DX)), OBJE, OR
END IF
LO4: LOOP WHILE OUTARY%(BX) <> 1
FIN:
LOCATE 23, 1: PRINT SPACE$(39)
LOCATE 23, 1: PRINT "CORRECTO(S/N)"
a$ = INPUT$(1)
IF a$ = "N" THEN GOTO PRINC


PX(N) = OUTARY%(CX) / 2: PY(N) = OUTARY%(DX)
END FUNCTION

FUNCTION COORDENADAS (N)
PRINT borra$(21, 24)
PRINCIPIO:
X1(N) = -1: Y1(N) = -1
INARY%(AX) = 0
a = RATON
INARY%(AX) = 1
a = RATON
DO
INARY%(AX) = 3
a = RATON
PEPE.CX = OUTARY%(CX)
PEPE.DX = OUTARY%(DX)
PEPE.BX = OUTARY%(BX)
IF O = 0 THEN O = OUTARY%(CX) / 2: E = OUTARY%(DX): GET (O, E)-(O, E), CACHO
IF PEPE.CX / 2 < O THEN NN = 0
IF PEPE.DX < E THEN NY = 0
IF NN = 1 THEN PEPE.CX = O * 2
IF NY = 1 THEN PEPE.DX = E
IF PEPE.CX / 2 < X1(N) THEN PEPE.CX = X1(N) * 2: GOTO LO3
IF PEPE.DX < Y1(N) THEN PEPE.DX = Y1(N): GOTO LO3
LOCATE 21, 1: PRINT "X="; PEPE.CX / 2; "               Y="; PEPE.DX

IF PEPE.BX = 0 AND X1(N) = -1 THEN GOTO LO3
IF PEPE.BX = 0 AND X1(N) <> -1 THEN GOTO FIN2
IF PEPE.BX = 1 AND X1(N) = -1 THEN
	IF yyya = 0 THEN
		X1(N) = (PEPE.CX / 2):
		Y1(N) = PEPE.DX:
		INARY%(AX) = 2:
		a = RATON:
		INARY%(AX) = 3:
		a = RATON
		yyya = 1
	END IF
END IF

IF PEPE.BX = 1 AND X1(N) <> -1 THEN
PUT (X1(N), Y1(N)), CACHO, PSET
	IF ABS(PEPE.CX / 2 - X1(N)) > 319 AND NN = 0 THEN O = PEPE.CX / 2: NN = 1
	IF ABS(PEPE.DX - Y1(N)) > 199 AND NY = 0 THEN E = PEPE.DX: NY = 1
GET (X1(N), Y1(N))-((PEPE.CX / 2), PEPE.DX), CACHO
IF NN = 0 THEN O = OUTARY%(CX) / 2
IF NY = 0 THEN E = OUTARY%(DX)
number = 65536 * 0 + 256 * 63 + 0
PALETTE 254, number
LINE (X1(N), Y1(N))-(O, E), 254, B

END IF

LO3:
LOOP
FIN2:
x2(N) = PEPE.CX / 2: y2(N) = PEPE.DX
INARY%(AX) = 2
a = RATON
LOCATE 23, 1: PRINT SPACE$(39)
LOCATE 23, 1: PRINT "CORRECTO(S/N)"
a$ = INPUT$(1)
a$ = UCASE$(a$)
IF a$ = "N" THEN PUT (X1(N), Y1(N)), CACHO, PSET: O = 0: E = 0: GOTO PRINCIPIO
END FUNCTION

FUNCTION CORDENA (N)
INARY%(AX) = 0
a = RATON
INARY%(AX) = 8
INARY%(CX) = 17
INARY%(DX) = 67
a = RATON
INARY%(AX) = 7
INARY%(CX) = 1
INARY%(DX) = 285 * 2
a = RATON
INARY%(AX) = 1
a = RATON
INARY%(AX) = 3
DO
a = RATON
LOCATE 21, 1: PRINT "X="; OUTARY%(CX) / 2; "               Y="; OUTARY%(DX)
LO5: LOOP WHILE OUTARY%(BX) <> 1
FIN3:
ELEC = INT(((OUTARY%(CX) / 2) / 41) + 1)
IF OUTARY%(DX) > 16 AND OUTARY%(DX) < 43 THEN ELE1 = 1: NUOBJD(N) = ELEC
IF OUTARY%(DX) > 42 AND OUTARY%(DX) < 68 THEN ELE1 = 2: NUOBJD(N) = ELEC + 8
INARY%(AX) = 2
a = RATON
SELECT CASE ELE1
CASE 1
GET (2 * ELEC + ((ELEC - 1) * 39), 17)-(2 * ELEC + (ELEC * 39), 41), OBJE
GET (2 * ELEC + ((ELEC - 1) * 39), 73)-(2 * ELEC + (ELEC * 39), 97), MASC
POY(N) = 17

CASE 2
GET (2 * ELEC + ((ELEC - 1) * 39), 43)-(2 * ELEC + (ELEC * 39), 67), OBJE
GET (2 * ELEC + ((ELEC - 1) * 39), 99)-(2 * ELEC + (ELEC * 39), 123), MASC
POY(N) = 43

END SELECT
POX(N) = 2 * ELEC + ((ELEC - 1) * 39)
CORDENA = ELEC
END FUNCTION

FUNCTION GRABAR (P$)
O: OPEN "o", #1, P$ + ".ALD"

PRINT #1, P$
PRINT #1, MU$(0)
PRINT #1, NOP(0)
PRINT #1, NOD(0)
FOR I = 1 TO NOP(0)
PRINT #1, NUM(I)
PRINT #1, X1(I)
PRINT #1, Y1(I)
PRINT #1, x2(I)
PRINT #1, y2(I)
PRINT #1, PUER(I): IF PUER(I) = 0 THEN GOTO NE
a$ = STR$(NPAN(I)): a$ = MID$(a$, 2, 1) + ".ALD"
PRINT #1, a$
PRINT #1, PDN(I)
PRINT #1, PPOS(I)

NE:
NEXT
PA$ = "99"
PRINT #1, PA$
FOR I = 1 TO NOD(0)
PRINT #1, NUOD(I)
PRINT #1, POX(I)
PRINT #1, POY(I)
PRINT #1, POX(I) + TAMANIOX(0)
PRINT #1, POY(I) + TAMANIOX(0)

PRINT #1, PX(I)
PRINT #1, PY(I)

NEXT

CLOSE
END FUNCTION

FUNCTION MENS$ (M$, Y, MODO)

SELECT CASE MODO
CASE 1
LOCATE Y, 1: PRINT SPACE$(39): LOCATE Y, 20 - LEN(M$) / 2: PRINT M$
CASE 2
LOCATE Y, 1: PRINT SPACE$(79): LOCATE Y, 40 - LEN(M$) / 2: PRINT M$
END SELECT

END FUNCTION

FUNCTION OBJSDISC (P$)
DO
LINE (0, 155)-(319, 199), 0, BF
M$ = "OBJETOS EN DISCO": PRINT MENS$(M$, 21, 1)
NA = NA + 1
NO:
SHELL "CACAGRAF 99":                               ' CARGA LA PANTALLA
																	'ANDE ESTA EL OBJETO
																	' CON LA MASCARA

N = CORDENA(NA)
NUOD(NA) = NUOBJD(NA)                              ' NUOD(NA) ES EL NUMERO DEL
																	' OBJETO DE DISCO NUMERO NA

	IF N = 0 THEN NOD(0) = NA: EXIT FUNCTION:       ' SI "N" VALE "0" TERMINA
																	' EL BUCLE Y EL NUMERO DE
																	' OBJETOS DE PANTALLA VALE
																	' "NA".MOLA OTRA VEZ, \xa8EH?



LINE (0, 155)-(319, 199), 0, BF

SHELL "CACAGRAF " + P$ + ".ALG"
a = COLOCA(NA)           ' SE COLOCA EL OBJETO CARGADO DONDE LE SALE A UNO DEL RATON Y
								 ' OBTENGO PX(NA) Y PY(NA) Y LAS MASCARAS


LO2:
LOOP WHILE NA < NOD(0)

END FUNCTION

FUNCTION OBJSPANT (P$)
DO
LINE (0, 155)-(319, 199), 0, BF
M$ = "OBJETOS EN PANTALLA": PRINT MENS$(M$, 21, 1)
NA = NA + 1

LOCATE 22, 1
	PRINT "NUMERO DE OBJETO "; NA; ":";
	INPUT "", N: NUM(NA) = N

a = COORDENADAS(NA): ' OBTENGO X1(N),Y1(N),X2(N),Y2(N)

LOCATE 21, 1: PRINT SPACE$((39 * 3) + 2): LOCATE 21, 1
INPUT "ES PUERTA (0 = NO, 1 = SI):", OP$
	IF OP$ <> "0" AND OP$ <> "1" THEN OP$ = "0"
	PUER(NA) = VAL(OP$):                          ' ALMACENA SI ES PUERTA (1)
																 ' O SI NO LO ES (0).
	IF PUER(NA) = 0 THEN GOTO LO:                 ' SI NO ES PUERTA, PASA AL
																 ' FINAL DEL BUCLE.

LINE (0, 155)-(319, 199), 0, BF
LOCATE 21, 1:
	INPUT "NUMERO DE LA PUERTA A LA QUE SALE:", PDN(NA)

INPUT "NUMERO DE PANTALLA A LA QUE VA:", OP$
	IF OP$ = "" THEN OP$ = P$:                ' SI OP$="" LA PANTALLA DE
															' DESTINO ES LA MISMA EN LA QUE
															' ESTA.
	NPAN(NA) = VAL(OP$):                      ' NPAN(N) ALMACENA LA PANTALLA
															' DE DESTINO DE LA PUERTA "NA".

INPUT "POS. PUERTA DESTINO (0 I. 1 D. 2 C.):", PPOS(NA)

LO:
LOOP WHILE NA < NOP(0):       ' SI "N" NO HA LLEGADO AL LIMITE, CONTINUA
										' EL BUCLE.

END FUNCTION

FUNCTION RATON
CALL INT86OLD(&H33, INARY%(), OUTARY%())
END FUNCTION
