DECLARE FUNCTION EDITAR! (V!)
DECLARE FUNCTION TECLA! ()
DECLARE SUB PANTALLA ()
DECLARE SUB OBJETOS ()
DECLARE SUB BANDERAS ()
DECLARE SUB VERBOS ()
DECLARE FUNCTION ELIGEFILA! ()
DECLARE FUNCTION GRABAPANT! (P!, DESC$, TTEX!)
DECLARE FUNCTION CARGAPANT! ()
DECLARE FUNCTION SEPARA! (OP$, V!, N!)
DECLARE FUNCTION IMPRVER$ (V!, N!)
DECLARE FUNCTION IMPROBJ$ (NO!)
DECLARE FUNCTION GRABAOBJ! (N!, NO!)
DECLARE FUNCTION CARGAOBJ! ()
DECLARE FUNCTION GRABANDER! (NB!, PIS!)
DECLARE FUNCTION IMPRBAND$ (NB!)
DECLARE FUNCTION CARGABAND! ()
DECLARE SUB SALIR ()
DECLARE SUB MAPA ()
DECLARE FUNCTION GRABMAP! (Y!, X!, P!)
DECLARE FUNCTION CARGAMAP! ()
DECLARE FUNCTION PRINMAP! (P!)
DECLARE FUNCTION SALIDAS! ()
DECLARE FUNCTION GRABSALID! (P!)
DECLARE FUNCTION PANT$ (X$, Y!, X!, A!, P!)
DECLARE FUNCTION CARGVERBOS! ()
DECLARE FUNCTION LISTA! (V!, LSI!, AC!)
DECLARE FUNCTION RATON! ()
DECLARE FUNCTION NUEVO! (V!)
DECLARE FUNCTION BORRAVER! (V!)
DECLARE FUNCTION GRABVER! (V!, F!)
DECLARE FUNCTION SINON! (V!)
'$INCLUDE: 'MENU.BI'
'$INCLUDE: 'QB.BI'

ON ERROR GOTO ERRORES
DIM SHARED DEN%(7), FUE%(7), DESC$(200), TTEX(200), NO$(100), VER$(20, 4)
DIM SHARED SELV(100, 20), NOV(100), VI(100), C(100), NB$(100), ESBAND(100)
DIM SHARED SELB(100), PEPE(1), CO$(0), VI$(0), COND$(0), NOP(100), YY(100)
DIM SHARED X(100), X$(100), SN(20), T$(30)

' COMPRUEBA RATON
	DEN%(ax) = 0
	A = RATON
		IF NOT FUE%(ax) THEN
			PRINT "No tienes instalado el rat\xa2n, hombre."
			END
		END IF

CLS
SCREEN 9
SCREEN 0

MENU:
ERASE DESC$, TTEX, NO$, VER$, SELV, NOV, VI, C, NB$, ESBAND, SELB, PEPE, CO$, VI$, COND$, NOP, YY, X, X$

ELIGE:
SCREEN 9: WIDTH 80: COLOR 10
CLS
M$ = "M E N U   P R I N C I P A L": PRINT MENSA$(M$, 2, 2)
M$ = "___________________________": PRINT MENSA$(M$, 3, 2)


PRINT BORRA$(5, 23)
COLOR 12
PRINT MENSA$("ELIGE UNA OPCION", 18, 2)
COLOR 14
PRINT MENSA$("(c) 1994 SANTIAGO LANCHA / ALCACHOFA SOFT. ALL RIGHTS RESERVED", 21, 2)

OP = MENU("1 - VERBOS     \2 - PANTALLA   \3 - OBJETOS    \4 - BANDERAS   \5 - MAPA       \6 - SALIR     ", 5, 4, 32.5, 99)


SELECT CASE OP
CASE 0, IS > 6
	GOTO ELIGE

CASE 1
	CALL VERBOS

CASE 2
	CALL PANTALLA

CASE 3
	CALL OBJETOS

CASE 4
	CALL BANDERAS

CASE 5
	CALL MAPA

CASE 6
	CALL SALIR

END SELECT

GOTO MENU



ERRORES:
IF ERR = 53 THEN
	A$ = MENSA$("NO HAY VERBOS DEFINIDOS", 7, 2)
SELECT CASE PEPE(1)
	CASE 5
	PEPE(1) = 99
	RESUME NEXT

END SELECT

END IF
CLS
PEPE(1) = 1: CLOSE : RESUME NEXT

SUB BANDERAS
NO = CARGAOBJ - 1
NB = CARGABAND
PIS = NB - 1: IF PIS = 0 THEN PIS = 1
B = NB
NB = NB - 1
IF NB > 0 THEN GOTO DEFI
PRINT IMPRBAND$(NB)
CLS
B = 1
NB$(B) = "COGER": LOCATE 13, 1: PRINT "OBJETOS QUE SE PUEDEN "; NB$(B)
LINE INPUT "", CO$(0)
PRINT

B = 2: NB = 2
NB$(B) = "VISIBLES": LOCATE 15, 1: PRINT "OBJETOS "; NB$(B)
LINE INPUT "", VI$(0)


CLS
B = 3
DEFI:
DO
M$ = "DEFINICION DE BANDERAS": PRINT MENSA$(M$, 1, 2)
A$ = IMPRBAND$(NB)

LOCATE 17, 1
M$ = "BANDERA NUMERO:" + STR$(B): PRINT MENSA$(M$, 16, 2)
INPUT "NOMBRE:", NB$(B)
IF NB$(B) = "" THEN B = B - 1: NB = B: A = GRABANDER(NB, PIS): EXIT SUB
INPUT "(0 \xa2 1):", ESBAND(B)

PRINT
INPUT "\xa8MAS?:", OP$: YA = 1
NB = B
IF OP$ = "S" THEN B = B + 1 ELSE A = GRABANDER(NB, PIS): EXIT SUB
LOOP





END SUB

FUNCTION BORRAVER (V)
COMIENZO:
PRINT BORRA$(18, 24)

LOCATE 20, 1
	LINE INPUT "ELIGE VERBO(S) A BORRAR:", OP$

IF OP$ = "" THEN
	FOR I = 1 TO V
		O$ = O$ + STR$(I) + " - " + VER$(I, 0) + "\"
	NEXT
	A = MENU(O$, 10, 9, 2, 17)
	SELV(0, 1) = A
	F = 1
ELSE
	F = SEPARA(OP$, V, 0)
END IF
A = LISTA(V, 0, 0)

LOCATE 20, 1
	INPUT "SEGURO(S/N):", OP$
	IF OP$ = "N" THEN GOTO COMIENZO


FOR I = 1 TO F
	FOR A = 0 TO 4
		VER$(SELV(0, I), A) = "\xfe"
	NEXT
	SN(SELV(0, I)) = 0
NEXT
A = GRABVER(V, F)

ERASE SELV
V = CARGVERBOS
A = LISTA(V, 0, 0)

LOCATE 21, 1
	INPUT "\xa8BORRAR MAS? (S/N):", OP$

IF OP$ = "S" THEN GOTO COMIENZO


END FUNCTION

FUNCTION CARGABAND
OPEN "I", #1, "FLAGS.DAT"
IF PEPE(1) = 1 THEN EXIT FUNCTION
LINE INPUT #1, NB$(1)
LINE INPUT #1, CO$(0)
LINE INPUT #1, NB$(2)
LINE INPUT #1, VI$(0)
I = 3
DO
IF EOF(1) THEN GOTO CI
LINE INPUT #1, NB$(I)
INPUT #1, ESBAND(I)
I = I + 1
LOOP

CI:
CARGABAND = I
CLOSE

END FUNCTION

FUNCTION CARGAMAP
OPEN "I", #1, "MAPA.DAT"
DO
	IF EOF(1) THEN EXIT DO
	INPUT #1, P
	INPUT #1, YY(P)
	INPUT #1, X(P)
LOOP
CLOSE

CARGAMAP = P
END FUNCTION

FUNCTION CARGAOBJ
OPEN "I", #1, "OBJETOS.DAT"
IF PEPE(1) = 1 THEN EXIT FUNCTION
I = 1
DO
IF EOF(1) THEN GOTO CIE
LINE INPUT #1, NO$(I)
INPUT #1, NOP(I)
INPUT #1, NOV(I)
FOR A = 1 TO NOV(I)
INPUT #1, SELV(I, A)
NEXT
I = I + 1
LOOP

CIE:
CARGAOBJ = I
CLOSE

END FUNCTION

FUNCTION CARGAPANT
OPEN "I", #1, "PANT.DAT"
IF PEPE(1) = 1 THEN EXIT FUNCTION
ABRE:
IF EOF(1) THEN GOTO CIERRE
INPUT #1, P
INPUT #1, TTEX(P)
LINE INPUT #1, DESC$(P)
P = P + 1: GOTO ABRE

CIERRE:
CARGAPANT = P
CLOSE

END FUNCTION

FUNCTION CARGVERBOS
ERASE VER$, SN
PEPE(1) = 5
OPEN "I", #1, "VERBOS.DAT"
IF PEPE(1) = 99 THEN V = 0: EXIT FUNCTION

INPUT #1, V
FOR I = 1 TO V
	INPUT #1, SN(I)
	FOR A = 0 TO SN(I)
		LINE INPUT #1, VER$(I, A)
	NEXT
NEXT

CLOSE
CARGVERBOS = V
END FUNCTION

FUNCTION EDITAR (V)
EDITAR:
PRINT BORRA$(1, 6)
PRINT MENSA$("EDITAR VERBOS", 1, 2)

DO
	PRINT BORRA$(17, 22)
	LOCATE 20, 1
		INPUT "NOMBRE DEL VERBO A EDITAR:", ED$
		IF VAL(ED$) <> 0 THEN ED$ = VER$(VAL(ED$), 0)
	IF ED$ = "" THEN EXIT DO

	FOR F = 1 TO V
		FOR A = 0 TO 4
			IF VER$(F, A) = ED$ THEN
				EDI = F
				EDA = A
				EXIT FOR
			END IF
		NEXT
	NEXT

	IF EDI = 0 THEN
		A$ = MENSA$("ESE VERBO NO EXISTE. PULSA UNA TECLA.", 18, 2)
		A = TECLA
		GOTO EDITAR
	END IF

	M$ = CHR$(34) + VER$(EDI, EDA) + CHR$(34)
	IF EDA <> 0 THEN M$ = M$ + " ES UN SINONIMO DE " + CHR$(34) + VER$(EDI, 0) + CHR$(34)

NOMBRE:
	PRINT BORRA$(18, 24)
	COLOR 10
	PRINT MENSA$(M$, 18, 2)
	COLOR 7

	LOCATE 20, 1
		LINE INPUT "NOMBRE:", VER$(EDI, EDA)
		INPUT "\xa8CORRECTO? (S/N):", OP$
			IF OP$ = "N" THEN GOTO NOMBRE
		A = GRABVER(V, 0)

LOOP

END FUNCTION

FUNCTION ELIGEFILA
EMPIEZE:
' ||| COLOCA EL CURSOR |||
LOCATE 1, 2: PRINT "LINEA DE COMIENZO:": I = 1
LINE (0, 0)-(7, 199), 0, BF
M$ = "'+' = ABAJO          '-' = ARRIBA": Y = 22: PRINT MENSA$(M$, Y, 1)
DO
A$ = INKEY$: LOCATE 1, 37: PRINT I
LOCATE I, 1: PRINT "\xdb"
IF I < 24 THEN LOCATE I + 1, 1: PRINT " "
IF I > 1 THEN LOCATE I - 1, 1: PRINT " "

SELECT CASE A$
	CASE "+"
	IF I < 24 THEN I = I + 1
	CASE "-"
	IF I > 1 THEN I = I - 1
	END SELECT
	IF VAL(A$) <> 0 THEN LOCATE I, 1: PRINT " ": I = VAL(A$)
LOOP WHILE A$ <> CHR$(13)

EN: ELIGEFILA = I: LOCATE I, 1: PRINT "AQUI ES": PRINT BORRA$(23, 23)
LOCATE 23, 1: INPUT "\xa8CORRECTO?:", A$
IF A$ = "N" THEN GOTO EMPIEZE
DO
LOCATE 23, 1: PRINT "PULSA UNA TECLA"
LOOP WHILE INKEY$ = ""

END FUNCTION

FUNCTION GRABANDER (NB, PIS)
OPEN "A", #1, "FLAGS.DAT"
IF PIS <= 1 THEN
PIS = 3
PRINT #1, NB$(1)
PRINT #1, CO$(0)
PRINT #1, NB$(2)
PRINT #1, VI$(0)
END IF
FOR I = PIS TO NB
PRINT #1, NB$(I)
PRINT #1, ESBAND(I)
NEXT
CLOSE
END FUNCTION

FUNCTION GRABAOBJ (N, NO)
OPEN "A", #1, "OBJETOS.DAT"
PRINT #1, NO$(N)
PRINT #1, NOP(N)
PRINT #1, NOV(N)
FOR A = 1 TO NOV(N)
PRINT #1, SELV(N, A)
NEXT
CLOSE
END FUNCTION

FUNCTION GRABAPANT (P, DESC$, TTEX)
OPEN "A", #1, "PANT.DAT"
PRINT #1, P
PRINT #1, TTEX(P)
PRINT #1, DESC$(P)
CLOSE
END FUNCTION

FUNCTION GRABMAP (Y, X, P)


SELECT CASE Y
CASE IS <> 0
	OPEN "A", #1, "MAPA.DAT"
		PRINT #1, P
		PRINT #1, Y
		PRINT #1, X
	CLOSE : EXIT FUNCTION

CASE IS = 0
OPEN "O", #1, "MAPA.DAT"
	FOR I = 1 TO P
		PRINT #1, I
		PRINT #1, YY(I)
		PRINT #1, X(I)
	NEXT
	CLOSE
END SELECT

END FUNCTION

FUNCTION GRABSALID (P)
OPEN "O", #1, "SALIDAS.DAT"

FOR I = 1 TO P
	PRINT #1, X$(I)
NEXT

CLOSE
END FUNCTION

FUNCTION GRABVER (V, F)
OPEN "O", #1, "VERBOS.DAT"
PRINT #1, V - F

FOR I = 1 TO V
	IF VER$(I, 0) <> "\xfe" THEN

		PRINT #1, SN(I)
		FOR A = 0 TO SN(I)
			PRINT #1, VER$(I, A)
		NEXT
	ELSE
	END IF
NEXT

CLOSE
GRABVER = V

END FUNCTION

FUNCTION IMPRBAND$ (NB)
CLS
M$ = "LISTA DE LAS BANDERAS DEFINIDAS HASTA AHORA": PRINT MENSA$(M$, 1, 2)
Y = 4: X = 1: A = 1: IF NB = 0 THEN LOCATE Y, X: PRINT "NO HAY BANDERAS DEFINIDAS"
LOCATE Y, X: PRINT " 1 - "; NB$(1); ":"; CO$(0)
LOCATE Y + 1, X: PRINT " 2 - "; NB$(2); ":"; VI$(0)
Y = Y + 2
FOR I = 3 TO NB
LOCATE Y, X
PRINT I; "- "; NB$(I); ":"; ESBAND(I)
IF Y = 12 AND VECES < 3 THEN Y = 3: VECES = VECES + 1: X = 21 * VECES
Y = Y + 1
NEXT

END FUNCTION

FUNCTION IMPROBJ$ (NO)
M$ = "LISTA DE LOS OBJETOS DEFINIDOS HASTA AHORA"
	PRINT MENSA$(M$, 2, 2)

Y = 5: X = 1

IF NO = 0 THEN
	LOCATE Y, X
	PRINT "NO HAY OBJETOS DEFINIDOS"
	EXIT FUNCTION
END IF

FOR I = 1 TO NO
	LOCATE Y, X
	COLOR 12
	PRINT I; "- ";
	COLOR 7
	PRINT NO$(I)
		IF Y = 12 AND VECES < 2 THEN
			Y = 5
			VECES = VECES + 1
			X = 26 * VECES
		END IF
	Y = Y + 1
NEXT

END FUNCTION

FUNCTION IMPRVER$ (V, N)
M$ = "LISTA DE LOS VERBOS DEFINIDOS HASTA AHORA": PRINT MENSA$(M$, 1, 2)
Y = 6: X = 1: A = 1
FOR I = 1 TO V
IF I = SELV(N, A) AND SELV(N, A) <> 0 THEN COLOR 15: A = A + 1 ELSE COLOR 7
LOCATE Y, X
PRINT I; "- "; VER$(I, 0)
IF Y = 12 AND VECES < 3 THEN Y = 5: VECES = VECES + 1: X = 21 * VECES
Y = Y + 1
NEXT
END FUNCTION

FUNCTION LISTA (V, LSI, AC)
CLS
VIEW PRINT
Y = 10: X = 2: HE = 2: OY = 3

IMPRE:
LINE (0, (6 * 8) - 1)-(639, (6 * 8) - 1), 8, B
COLOR 13
PRINT MENSA$("LISTA DE VERBOS. TABLA" + STR$(LSI + 1), 7, 2)
COLOR 7
NUM = V: IU = 1
FOR N = 1 TO NUM

	IF SELV(AC, IU) = N THEN IU = IU + 1: VEO = 11 ELSE VEO = 7

	IF N > 9 THEN X = HE - 1
	IF NO = 0 AND LEN(VER$(N, LSI)) <= 20 THEN
		LOCATE Y, X
		COLOR 12
		PRINT N; "- ";
		COLOR VEO
		PRINT VER$(N, LSI)
		COLOR 7
		Y = Y + 1
	END IF
	IF NO = 0 AND LEN(VER$(N, LSI)) > 20 THEN
		LOCATE Y, X
		PE$ = STR$(N) + "- "
		COLOR 12
		PRINT N; "- "
		COLOR VEO
		X = X + LEN(PE$) + 1
		M$ = VER$(N, LSI)

			NE$ = M$
			RANDOMIZE TIMER
			F = 0
			FOR I = 20 TO 1 STEP -1
				M2$ = MID$(M$, I, 1):
				IF M2$ = " " THEN
					NE$ = MID$(M$, I + 1, LEN(M$))
					M$ = MID$(M$, 1, I - 1)
					EXIT FOR
				END IF
				NEXT
				O = 1

		LOCATE Y, X
		PRINT M$
		LOCATE Y + 1, X
		PRINT NE$
		Y = Y + 2
		X = HE
		COLOR 7
	END IF
SELECT CASE Y
	CASE IS > 16
		IF HE > 1 THEN
			X = X + 26
			HE = X
			Y = 10
		END IF

END SELECT
NEXT

A:
LISTA = NUM
END FUNCTION

SUB MAPA
SCREEN 0
CLS
P = 1
P = CARGAMAP
A = PRINMAP(P)
P = P + 1
DEN%(ax) = 0
A = RATON
DEN%(ax) = 8
DEN%(cx) = 24
DEN%(dx) = 24 * 8
AHORA = 1
A = RATON

DO
	IF INKEY$ = CHR$(27) THEN EXIT DO
	IF AHORA = 1 THEN R = CARGAMAP: AHORA = 0
	PRINT BORRA$(1, 3)
	LOCATE 1, 1
	PRINT "COLOCA LA PANTALLA:"; P

ELI:
	DEN%(ax) = 1
	A = RATON
	DO
		IF INKEY$ = CHR$(27) THEN GOTO FUER
		DEN%(ax) = 3
		A = RATON
	LOOP WHILE FUE%(bx) = 0

			Y = (FUE%(dx) / 8) + 1: X = (FUE%(cx) / 8) + 1
	SELECT CASE FUE%(bx)
		CASE 1
			FOR G = 1 TO R
				IF YY(G) = Y AND X(G) = X THEN BEEP: GOTO OPER
			NEXT
			DEN%(ax) = 2
			A = RATON
			PRINT BORRA$(2, 2): LOCATE Y, X: PRINT "\xfe"
			A = GRABMAP(Y, X, P)
			AHORA = 1
			P = P + 1

		CASE 4
			FOR G = 1 TO R
				IF YY(G) = Y AND X(G) = X THEN
					FOR H = G TO R
					YY(H) = YY(H + 1): X(H) = X(H + 1)
					NEXT: R = R - 1
					DEN%(ax) = 2
					A = RATON
					LOCATE Y, X: PRINT " "
					P = P - 2: IF P = 0 THEN P = 1: GOTO OPER
					A = GRABMAP(0, 0, P): P = P + 1
					EXIT FOR
				 END IF
			NEXT

	END SELECT

OPER:
LOOP

FUER:
LOCATE 2, 1: INPUT "\xa8SALIR?:", OP$
	IF OP$ = "N" THEN LOCATE Y, X: PRINT " ": GOTO ELI

A = SALIDAS

END SUB

FUNCTION NUEVO (V)
PRINT BORRA$(1, 6)
PRINT MENSA$("INTRODUCIR NUEVO VERBO", 1, 2)
I = V
DO
I = I + 1
PRINT BORRA$(17, 22)
LOCATE 20, 1
PRINT "NOMBRE DEL VERBO "; I; ":"; : INPUT "", VER$(I, 0)
LOOP UNTIL VER$(I, LSI) = ""
IF I <> V THEN
	V = I - 1
	A = GRABVER(V, 0)
END IF
END FUNCTION

SUB OBJETOS
SCREEN 9
WIDTH 80
V = CARGVERBOS
NO = CARGAOBJ
PIS = NO
IF PIS = 0 THEN PIS = 1: NO = 1

NO = NO - 1
N = NO
IF N < 0 THEN N = 0

DO
	CLS
	PRINT IMPROBJ$(NO)
	Y = 16
	COLOR 10
	M$ = "DEFINICION DE OBJETOS"
		PRINT MENSA$(M$, Y, 2):

	COLOR 15
	Y = 17
	PRINT BORRA$(Y, 23)
	Y = 18

	N = N + 1
	LOCATE Y, 1
		PRINT "NOMBRE DEL OBJETO:";
		INPUT "", NO$(N)
		INPUT "\xa8EN QUE PANTALLA ESTA?:", NOP(N)

			IF NO$(N) = "" THEN EXIT SUB

	PRINT BORRA$(1, 23)
	A = LISTA(V, LSI, N)

	LOCATE Y, 1
		PRINT "ELIGE VERBO(S):";
		LINE INPUT "", OP$

	IF OP$ = "" THEN
		FOR I = 1 TO V
			O$ = O$ + STR$(I) + " - " + VER$(I, 0) + "\"
		NEXT
		I = 0

	A = MENU(O$, 10, 9, 2, 17)
	SELV(N, 1) = A
	NOV(N) = 1
	ELSE
		F = SEPARA(OP$, V, N)
		NOV(N) = F
	END IF

	A = LISTA(V, LSI, N)

	PRINT BORRA$(Y, 23)
	NO = N
	A = GRABAOBJ(N, NO)

	COLOR 7
		LOCATE Y, 1
		INPUT "\xa8MAS OBJETOS?:", Q$
			Q$ = UCASE$(Q$)

LOOP WHILE Q$ = "S"

END SUB

FUNCTION PANT$ (X$, Y, X, A, P)
		FOR J = 1 TO P

SELECT CASE A
	CASE 1
		IF Y = YY(J) + 1 THEN X$ = X$ + MID$(STR$(J), 2, LEN(STR$(J))): EXIT FOR
	CASE 2
		IF Y = YY(J) - 1 THEN X$ = X$ + MID$(STR$(J), 2, LEN(STR$(J))): EXIT FOR
	CASE 3
		IF Y = YY(J) + 1 AND X = X(J) - 1 THEN X$ = X$ + MID$(STR$(J), 2, LEN(STR$(J))): EXIT FOR
	CASE 4
		IF Y = YY(J) + 1 AND X = X(J) + 1 THEN X$ = X$ + MID$(STR$(J), 2, LEN(STR$(J))): EXIT FOR
	CASE 5
		IF Y = YY(J) - 1 AND X = X(J) - 1 THEN X$ = X$ + MID$(STR$(J), 2, LEN(STR$(J))): EXIT FOR
	CASE 6
		IF Y = YY(J) - 1 AND X = X(J) + 1 THEN X$ = X$ + MID$(STR$(J), 2, LEN(STR$(J))): EXIT FOR
	CASE 7
		IF X = X(J) - 1 THEN X$ = X$ + MID$(STR$(J), 2, LEN(STR$(J))): EXIT FOR
	CASE 8
		IF X = X(J) + 1 THEN X$ = X$ + MID$(STR$(J), 2, LEN(STR$(J))): EXIT FOR

END SELECT
NEXT

PANT = X$
END FUNCTION

SUB PANTALLA

P = CARGAPANT
PRINT BORRA$(20, 24)
LOCATE 20, 1
	PRINT "NUMERO DE PANTALLA: ["; P; "]:";
	INPUT "", N

	IF N = 0 THEN P = P ELSE P = N

PANTA:
CLS
SCREEN 13
	IF P = 0 THEN P = 1

SHELL "CACAGRAF " + STR$(P) + ".ALG"
TTEX(P) = ELIGEFILA

M$ = "DESCRIPCION DE LA PANTALLA:" + STR$(P)
	PRINT MENSA$(M$, 1, 1)

Y = TTEX(P)

DESC$(P) = INTROD$(Y, 1)
	PRINT BORRA$(TTEX(P), 24)
	DESC$ = DESC$(P)
	TTEX = TTEX(P)

A = GRABAPANT(P, DESC$, TTEX)

LOCATE TTEX(P), 1
	INPUT "\xa8OTRA?:", OP$
	OP$ = UCASE$(OP$)

		IF OP$ = "S" THEN P = P + 1: GOTO PANTA

END SUB

FUNCTION PRINMAP (P)

FOR I = 1 TO P
LOCATE YY(I), X(I): PRINT "\xfe"
NEXT


END FUNCTION

FUNCTION RATON
CALL INT86OLD(&H33, DEN%(), FUE%())
END FUNCTION

FUNCTION SALIDAS
P = CARGAMAP
FOR I = 1 TO P
	IF SCREEN(YY(I) - 1, X(I)) = 254 THEN X$(I) = X$(I) + ",N": A = 1: GOSUB PANTALLA
	IF SCREEN(YY(I) + 1, X(I)) = 254 THEN X$(I) = X$(I) + ",S": A = 2: GOSUB PANTALLA
	IF SCREEN(YY(I) - 1, X(I) + 1) = 254 THEN X$(I) = X$(I) + ",NE": A = 3: GOSUB PANTALLA
	IF SCREEN(YY(I) - 1, X(I) - 1) = 254 THEN X$(I) = X$(I) + ",NO": A = 4: GOSUB PANTALLA
	IF SCREEN(YY(I) + 1, X(I) + 1) = 254 THEN X$(I) = X$(I) + ",SE": A = 5: GOSUB PANTALLA
	IF SCREEN(YY(I) + 1, X(I) - 1) = 254 THEN X$(I) = X$(I) + ",SO": A = 6: GOSUB PANTALLA
	IF SCREEN(YY(I), X(I) + 1) = 254 THEN X$(I) = X$(I) + ",E": A = 7: GOSUB PANTALLA
	IF SCREEN(YY(I), X(I) - 1) = 254 THEN X$(I) = X$(I) + ",O": A = 8: GOSUB PANTALLA


IF MID$(X$(I), 1, 1) = "," THEN X$(I) = MID$(X$(I), 2, LEN(X$(I)))

NEXT:

A = GRABSALID(P)
EXIT FUNCTION

PANTALLA:
Y = YY(I): X = X(I): X$ = X$(I)
R$ = PANT$(X$, Y, X, A, P)
X$(I) = R$
RETURN


END FUNCTION

SUB SALIR
PRINT
INPUT "\xa8ESTAS SEGURO?:", OP$
IF OP$ = "S" THEN END
END SUB

FUNCTION SEPARA (OP$, V, N)
F = 1
HOLA2:
A = INSTR(OP$, "-"): a2 = INSTR(OP$, ","): IF a2 <> 0 THEN OP2$ = MID$(OP$, a2 + 1, LEN(OP$)): OP$ = MID$(OP$, 1, a2 - 1)
IF A = 0 THEN GOTO FI
R1 = VAL(MID$(OP$, 1, A - 1)): R2 = VAL(MID$(OP$, A + 1, LEN(OP$)))
IF R1 = 0 THEN R1 = 1
IF R1 > R2 THEN R3 = R2: R2 = R1: R1 = R3: R3 = 0
IF R2 = 0 THEN R2 = V
IF R2 > V THEN R2 = V
FOR I = R1 TO R2
SELV(N, F) = I: F = F + 1
NEXT
SEPARA = F - 1
IF OP2$ = "" THEN EXIT FUNCTION ELSE OP$ = OP2$: OP2$ = "": R1 = 0: R2 = 0: GOTO HOLA2

FI:
SELV(N, F) = VAL(OP$)
IF OP2$ <> "" THEN OP$ = OP2$: OP2$ = "": R1 = 0: R2 = 0: F = F + 1: GOTO HOLA2
SEPARA = F

FOR B = 1 TO F
T$(B) = STR$(SELV(N, B))
NEXT
FOR I = 1 TO 16
A = 2 ^ I
IF A >= F THEN Z = INT((2 ^ I - 1) / 2): EXIT FOR
NEXT
1310 B = F - Z
C = 1
1330 D = C
1340 E = D + Z
IF VAL(T$(D)) <= VAL(T$(E)) THEN GOTO 1410
A$ = T$(D)
T$(D) = T$(E)
T$(E) = A$
D = D - Z
IF D >= 1 THEN GOTO 1340
1410 C = C + 1
IF C <= B THEN GOTO 1330
Z = INT(Z / 2)
IF Z <> 0 THEN GOTO 1310

FOR I = 1 TO F
SELV(N, I) = VAL(T$(I))
NEXT

END FUNCTION

FUNCTION SINON (V)

PRINT BORRA$(1, 6)
PRINT MENSA$("INTRODUCIR NUEVO SINONIMO", 1, 2)

PRINT BORRA$(17, 22)
LOCATE 20, 1
INPUT "VERBO PRINCIPAL:", PRI$
IF VAL(PRI$) <> 0 THEN
	SINO = VAL(PRI$)
	PRI$ = VER$(VAL(PRI$), 0)
ELSE
	FOR I = 1 TO V
		IF VER$(I, 0) = PRI$ THEN
			SINO = I
			EXIT FOR
		END IF
	NEXT
END IF
I = SN(SINO)
PRINT MENSA$(PRI$, 18, 2)

DO
	I = I + 1
	PRINT BORRA$(19, 22)
	LOCATE 20, 1
		PRINT "NOMBRE DEL SINONIMO "; I; ":";
		INPUT "", R$
		VER$(SINO, I) = UCASE$(R$)

LOOP UNTIL VER$(SINO, I) = "" AND I < 4

SN(SINO) = I - 1
A = GRABVER(V, 0)


END FUNCTION

FUNCTION TECLA

DO
LOOP UNTIL INKEY$ = ""

END FUNCTION

SUB VERBOS
PRINCI:
CLS
SCREEN 9
V = CARGVERBOS
IF V <> 0 THEN
	 DO
	 A = LISTA(V, LSI, AC): V = A
	 IF LSI = 4 THEN EXIT DO
	 LOCATE 20, 1: INPUT "SEGUIR MOSTRANDO (S/N):", OP$
		OP$ = UCASE$(OP$)
		IF OP$ <> "S" THEN EXIT DO
	 LSI = LSI + 1
	 LOOP
END IF
MEN1:
PRINT BORRA$(1, 6)
PRINT BORRA$(20, 24)
OPCI = MENU("INTRODUCIR VERBOS/EDITAR VERBOS/BORRAR VERBOS/GRABAR/CARGAR/TABLA/SALIR", 1, 12, 1, 6)
SELECT CASE OPCI
	CASE 1
	OPCI1 = MENU("INTRODUCIR VERBO\INTRODUCIR SINONIMO", 3, 11, 3, 6)
		SELECT CASE OPCI1
			CASE 0
			GOTO MEN1

			CASE 1
			A = NUEVO(V)

			CASE 2
			A = SINON(V)
		END SELECT

	CASE 2
	A = EDITAR(V)

	CASE 3
	A = BORRAVER(V)

	CASE 4
	A = GRABVER(V, 0)

	CASE 5
	A = CARGAVERBOS

	CASE 6, 0
	LSI = 0
	GOTO PRINCI

	CASE 7
	EXIT SUB
END SELECT
GOTO PRINCI
END SUB
